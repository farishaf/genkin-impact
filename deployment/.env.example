# Copy to deployment/.env and fill in per-project. docker compose auto-loads
# this file (it must sit next to the compose files) and substitutes ${VARS}
# in the docker-compose-deploy-*.yml files.

PROJECT_NAME=genkin-impact
BACKEND_DIR=backend
FRONTEND_DIR=frontend

# HOST ports. Container-side ports are fixed: backend 4000, frontend 3000.
# Defaults avoid ganbaro (4000/3001) when both run on the same server.
BACKEND_PORT=4001
FRONTEND_PORT=3002

# backend/.env on the server must point at the db container, e.g.
#   DATABASE_URL=postgres://<user>:<pass>@genkin-impact-db-prod:5432/<db>
#   PORT=4000
#   NODE_ENV=production
#   APP_ORIGIN=https://<public frontend domain>
#   DEEPSEEK_API_KEY=<key>            (optional: turns on receipt scanning)
#   DEEPSEEK_MODEL=deepseek-flash
